{
  "$description": "Tema oscuro — la base del sitio y del producto. Cada token referencia un primitivo; ningún hex se escribe acá.",
  "color": {
    "bg": {
      "default":        { "$value": "{color.graphite.17}", "$type": "color" },
      "surface":        { "$value": "{color.graphite.14}", "$type": "color" },
      "surface-raised": { "$value": "{color.graphite.13}", "$type": "color" },
      "surface-alt":    { "$value": "{color.graphite.15}", "$type": "color", "$description": "Filas alternas de tabla" }
    },
    "border": {
      "default": { "$value": "{color.graphite.11}", "$type": "color" },
      "subtle":  { "$value": "{color.graphite.12}", "$type": "color" }
    },
    "fg": {
      "default": { "$value": "{color.graphite.4}",  "$type": "color" },
      "muted":   { "$value": "{color.graphite.7}",  "$type": "color" },
      "subtle":  { "$value": "{color.graphite.9}",  "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{color.mint.3}",  "$type": "color" },
      "hover":   { "$value": "{color.mint.1}",  "$type": "color" },
      "on":      { "$value": "{color.graphite.17}", "$type": "color", "$description": "El color del texto que va ENCIMA del acento. Nunca blanco: sobre el menta daría 1.46:1 y no pasa AA." },
      "subtle":  { "$value": "{color.mint.7}",  "$type": "color" },
      "border":  { "$value": "{color.mint.4}",  "$type": "color" },
      "atmosphere": { "$value": "{color.mint.8}", "$type": "color", "$description": "Decoración, no interfaz: solo lo leen los campos de partículas y las retículas del hero. No lo usa ningún texto, borde ni botón, así que queda FUERA del cálculo de contraste. Va más apagado que el acento a propósito — ver la nota del primitivo mint.8." }
    },
    "status": {
      "critical": { "$value": "{color.red.400}",   "$type": "color" },
      "warning":  { "$value": "{color.amber.400}", "$type": "color" },
      "info":     { "$value": "{color.blue.400}",  "$type": "color" },
      "success":  { "$value": "{color.green.400}", "$type": "color" }
    },
    "utility": {
      "$description": "Los insumos energéticos. Croma menor que los estados: su trabajo es etiquetar, no gritar.",
      "electricity": { "$value": "{color.yellow.400}", "$type": "color" },
      "gas":         { "$value": "{color.orange.400}", "$type": "color" },
      "diesel":      { "$value": "{color.violet.400}", "$type": "color" },
      "water":       { "$value": "{color.cyan.400}",   "$type": "color" },
      "waste":       { "$value": "{color.clay.400}",   "$type": "color" }
    }
  },

  "effect": {
    "$description": "Efectos de superficie del tema. No son tipos estándar de DTCG: llevan tipo propio y salen a CSS tal cual.",
    "field": {
      "$value": "radial-gradient(85% 60% at 50% -10%, #FFFFFF08 0%, transparent 60%)",
      "$type": "custom-css",
      "$description": "El campo: halo superior sutil"
    },
    "grain": { "$value": "0.03", "$type": "number", "$description": "Opacidad del grano" }
  }
}
