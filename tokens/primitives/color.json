{
  "$description": "Primitivos de color: los valores crudos, sin significado asignado. Nadie los usa directo — los consume la capa semántica. Congelados el 2026-08-07 (D25–D26).",
  "color": {
    "graphite": {
      "$description": "La rampa de grafito: casi-negro neutro. No es una escala matemática — cada valor se eligió por su par de contraste, así que los índices son ordinales, no proporcionales.",
      "0":  { "$value": "#FFFFFF", "$type": "color" },
      "1":  { "$value": "#FAFAF9", "$type": "color" },
      "2":  { "$value": "#F8F8F7", "$type": "color" },
      "3":  { "$value": "#F4F4F3", "$type": "color" },
      "4":  { "$value": "#EDEFEE", "$type": "color" },
      "5":  { "$value": "#EBECEA", "$type": "color" },
      "6":  { "$value": "#E0E1DF", "$type": "color" },
      "7":  { "$value": "#8A918F", "$type": "color" },
      "8":  { "$value": "#868C8A", "$type": "color" },
      "9":  { "$value": "#5C6362", "$type": "color" },
      "10": { "$value": "#585E5C", "$type": "color" },
      "11": { "$value": "#252929", "$type": "color" },
      "12": { "$value": "#1B1F1F", "$type": "color" },
      "13": { "$value": "#191C1C", "$type": "color" },
      "14": { "$value": "#121414", "$type": "color" },
      "15": { "$value": "#0F1111", "$type": "color" },
      "16": { "$value": "#0E100F", "$type": "color" },
      "17": { "$value": "#0B0C0C", "$type": "color" }
    },

    "celadon": {
      "$description": "El acento de marca. #BADDCE es el celadón congelado; el resto son sus derivados por tema.",
      "0": { "$value": "#E7F2ED", "$type": "color" },
      "1": { "$value": "#CFE9DE", "$type": "color" },
      "2": { "$value": "#C3D9CF", "$type": "color" },
      "3": { "$value": "#BADDCE", "$type": "color", "$description": "El celadón de marca. Este es EL color." },
      "4": { "$value": "#2E3F39", "$type": "color" },
      "5": { "$value": "#1C3A30", "$type": "color" },
      "6": { "$value": "#122A22", "$type": "color" },
      "7": { "$value": "#161E1B", "$type": "color" }
    },

    "red": {
      "$description": "Crítico. Croma alto: su trabajo es interrumpir.",
      "400": { "$value": "#F0555F", "$type": "color", "$description": "OKLCH H 22" },
      "700": { "$value": "#C42F36", "$type": "color" }
    },
    "amber": {
      "$description": "Alerta. Corrido del naranja al ámbar amarillo para dejarle sitio al gas LP.",
      "400": { "$value": "#E8B23C", "$type": "color", "$description": "OKLCH H 78" },
      "700": { "$value": "#9A7407", "$type": "color" }
    },
    "blue": {
      "400": { "$value": "#6A9CE0", "$type": "color", "$description": "OKLCH H 260" },
      "700": { "$value": "#2358CE", "$type": "color" }
    },
    "green": {
      "$description": "Éxito. Bajado en luz y corrido en matiz para despegarlo del celadón (H 165).",
      "400": { "$value": "#42AC57", "$type": "color", "$description": "OKLCH H 145, L .65" },
      "700": { "$value": "#1E7A3A", "$type": "color" }
    },

    "yellow": {
      "$description": "Electricidad. Abierto 24° respecto del ámbar de alerta.",
      "400": { "$value": "#EDE96A", "$type": "color", "$description": "H 107" },
      "700": { "$value": "#7E8A00", "$type": "color" }
    },
    "orange": {
      "$description": "Gas. Ocupa el hueco de matiz que dejó libre el ámbar de alerta.",
      "400": { "$value": "#E07A45", "$type": "color", "$description": "H 47" },
      "700": { "$value": "#A85C14", "$type": "color", "$description": "Abierto 33° respecto de crítico" }
    },
    "violet": {
      "400": { "$value": "#A08FDB", "$type": "color", "$description": "H 300" },
      "700": { "$value": "#5B47A8", "$type": "color" }
    },
    "cyan": {
      "400": { "$value": "#5FB3D9", "$type": "color", "$description": "H 230" },
      "700": { "$value": "#0E6E96", "$type": "color" }
    },
    "clay": {
      "$description": "Residuos. Croma .025, casi neutro a propósito: se separa de electricidad por croma, no por matiz.",
      "400": { "$value": "#93876F", "$type": "color", "$description": "H 85" },
      "700": { "$value": "#6E6353", "$type": "color" }
