{
  "name": "@riemann-energy/tokens",
  "version": "1.0.0",
  "description": "Sistema de marca de Riemann Energy: tokens de diseño, marca y tipografías",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "dist/tokens.js",
  "style": "dist/tokens.css",
  "exports": {
    ".": "./dist/tokens.js",
    "./css": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": ["dist", "brand-assets", "fonts"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:visual": "node scripts/check-visual.mjs",
    "check": "npm run build && npm run check:tokens && npm run check:contrast",
    "fonts": "node scripts/fetch-fonts.mjs",
    "og": "node scripts/render-og.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "style-dictionary": "^5.0.0"
  }
}
